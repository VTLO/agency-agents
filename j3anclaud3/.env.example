# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Mode de fonctionnement ----------------------------------------------------
# orchestre    : cadrage -> plan -> validation humaine -> production avec les skills
# conversation : simple chat en langage naturel, sans skills
# (surchargeable au lancement : j3anclaud3 serve --mode conversation)
J3_MODE=orchestre
# messages gardés en mémoire (mode conversation)
J3_CHAT_HISTORY=20

# --- Administrateur --------------------------------------------------------------
# Tout le monde peut discuter avec le bot. Renseigner J3_ADMIN_PASSWORD active le compte
# administrateur : son nom est réservé (mot de passe exigé), il voit la consommation de
# chacun, peut bloquer une personne et, si J3_ADMIN_APPROVAL=1, lui seul lance la production.
J3_ADMIN_NAME=admin
# vide = pas d'admin ; générer : python -c "import secrets; print(secrets.token_urlsafe(24))"
J3_ADMIN_PASSWORD=
# 0 = tout le monde peut valider un plan
J3_ADMIN_APPROVAL=1

# --- Validation des plans (mode orchestre) ------------------------------------
J3_REQUIRED_APPROVALS=1
# 0 = l'auteur d'un plan ne peut pas le valider lui-même
J3_ALLOW_SELF_APPROVAL=1
# J3_SECRET=                           # signe les sessions ; généré dans J3_DATA_DIR si vide

# --- Économie de tokens -------------------------------------------------------
J3_MODEL_LITE=claude-haiku-4-5
J3_MODEL_STD=claude-sonnet-5-5
J3_MODEL_MAX=claude-opus-5-5
J3_EFFORT_STD=low
J3_EFFORT_MAX=medium
# dialogue FR avec l'équipe
J3_CHAT_TIER=S
# conception du plan
J3_PLAN_TIER=M
# message de livraison
J3_SUMMARY_TIER=L
# repli serveur en cas de refus (Sonnet/Opus)
J3_SERVER_FALLBACKS=1
# taille max d'un skill "lite"
J3_SKILL_PROMPT_TOKENS=900
# skills proposés au planificateur
J3_SHORTLIST=10
# tours de conversation bruts conservés
J3_CHAT_WINDOW=6
J3_MAX_STEPS=8
# au-delà, le plan affiche un avertissement
J3_BUDGET_TOKENS=120000
# suspension si dépassement x1.5 de l'estimation
J3_BUDGET_SLACK=1.5
J3_PARALLELISM=3

# --- Serveur ------------------------------------------------------------------
J3_DATA_DIR=./j3anclaud3-data
PORT=8080
# HOST=0.0.0.0                         # mettre 127.0.0.1 pour un usage uniquement local
# J3_AGENCY_ROOT=/chemin/vers/agency-agents   # défaut : racine du dépôt
