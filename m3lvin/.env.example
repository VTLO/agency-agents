# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- WhatsApp Business Cloud API (Meta) --------------------------------------
WHATSAPP_TOKEN=EAAG...                 # permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_APP_SECRET=meta-app-secret    # enables X-Hub-Signature-256 checks
WHATSAPP_API_VERSION=v21.0

# --- Gouvernance ---------------------------------------------------------------
M3_TEAM=33611111111,33622222222        # numbers allowed to talk to M3LVin (empty = anyone)
M3_APPROVERS=33622222222               # numbers allowed to VALIDER (empty = any team member)
M3_REQUIRED_APPROVALS=1
M3_ALLOW_SELF_APPROVAL=1               # 0 = four-eyes: author cannot approve their own plan

# --- Économie de tokens ---------------------------------------------------------
M3_MODEL_LITE=claude-haiku-4-5
M3_MODEL_STD=claude-sonnet-5-5
M3_MODEL_MAX=claude-opus-5-5
M3_EFFORT_STD=low
M3_EFFORT_MAX=medium
M3_CHAT_TIER=S                         # dialogue FR avec l'équipe
M3_PLAN_TIER=M                         # conception du plan
M3_SUMMARY_TIER=L                      # message de livraison
M3_SERVER_FALLBACKS=1                  # server-side refusal fallbacks (Sonnet/Opus)
M3_SKILL_PROMPT_TOKENS=900             # taille max d'un skill "lite"
M3_SHORTLIST=10                        # skills proposés au planificateur
M3_CHAT_WINDOW=6                       # tours de conversation bruts conservés
M3_MAX_STEPS=8
M3_BUDGET_TOKENS=120000                # au-delà, le plan affiche un avertissement
M3_BUDGET_SLACK=1.5                    # suspension si dépassement x1.5 de l'estimation
M3_PARALLELISM=3

# --- Divers ----------------------------------------------------------------------
M3_DATA_DIR=./m3lvin-data
# M3_AGENCY_ROOT=/path/to/agency-agents   # defaults to the repo root
PORT=8080
