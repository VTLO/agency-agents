# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Comptes de l'équipe ------------------------------------------------------
# nom:rôle:code — rôle = approver (peut VALIDER) ou member. Le code sert de mot de
# passe dans l'interface web et de jeton Bearer pour l'API HTTP.
# Vide = mode ouvert (usage local uniquement : tout le monde peut tout faire).
M3_USERS=alice:approver:change-moi-1,bob:member:change-moi-2
M3_REQUIRED_APPROVALS=1
M3_ALLOW_SELF_APPROVAL=1               # 0 = l'auteur d'un plan ne peut pas le valider
# M3_SECRET=                           # signe les sessions ; généré dans M3_DATA_DIR si vide

# --- Économie de tokens -------------------------------------------------------
M3_MODEL_LITE=claude-haiku-4-5
M3_MODEL_STD=claude-sonnet-5-5
M3_MODEL_MAX=claude-opus-5-5
M3_EFFORT_STD=low
M3_EFFORT_MAX=medium
M3_CHAT_TIER=S                         # dialogue FR avec l'équipe
M3_PLAN_TIER=M                         # conception du plan
M3_SUMMARY_TIER=L                      # message de livraison
M3_SERVER_FALLBACKS=1                  # repli serveur en cas de refus (Sonnet/Opus)
M3_SKILL_PROMPT_TOKENS=900             # taille max d'un skill "lite"
M3_SHORTLIST=10                        # skills proposés au planificateur
M3_CHAT_WINDOW=6                       # tours de conversation bruts conservés
M3_MAX_STEPS=8
M3_BUDGET_TOKENS=120000                # au-delà, le plan affiche un avertissement
M3_BUDGET_SLACK=1.5                    # suspension si dépassement x1.5 de l'estimation
M3_PARALLELISM=3

# --- Serveur ------------------------------------------------------------------
M3_DATA_DIR=./m3lvin-data
PORT=8080
# HOST=0.0.0.0                         # défaut : 0.0.0.0 avec comptes, 127.0.0.1 en mode ouvert
# M3_AGENCY_ROOT=/chemin/vers/agency-agents   # défaut : racine du dépôt
