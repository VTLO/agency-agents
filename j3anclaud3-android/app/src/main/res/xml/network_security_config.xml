<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS is recommended. Clear-text HTTP stays possible for a J3anClaud3 server on your own
     local network (e.g. http://192.168.1.20:8080); the app warns when it is used. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
